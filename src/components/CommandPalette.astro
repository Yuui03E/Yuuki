---
import Icon from './Icon.astro';
---
<dialog id="command-palette" aria-label="Search the Yuuki archive" data-pagefind-ignore>
  <div class="search-field"><Icon name="search" size={20}/><label class="sr-only" for="global-search">Search the archive</label><input id="global-search" type="search" placeholder="Search releases, anime, guides…" autocomplete="off" aria-controls="search-results" aria-describedby="search-status"/><button class="escape-button" type="button" data-search-close aria-label="Close search"><kbd>Esc</kbd></button></div>
  <div class="search-subhead"><span id="search-status" aria-live="polite">Explore the archive</span><span class="mono">QUICK FIND</span></div>
  <div id="search-results" role="list" aria-label="Search results"></div>
  <div class="search-footer"><span><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>↵</kbd> open</span><span><span class="cyan">[</span> Yuuki <span class="cyan">]</span></span></div>
</dialog>
<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>
<style>
  dialog { padding: 0; width: min(620px, calc(100% - 28px)); max-height: min(660px, 85vh); margin: 12vh auto auto; overflow: hidden; }
  .search-field { display: flex; align-items: center; gap: 12px; padding: 18px 20px; border-bottom: 1px solid var(--border); color: var(--cyan); }
  .search-field input { background: transparent; border: 0; border-radius: 0; padding: 0; font-size: 1rem; color: var(--text); box-shadow: none; outline: none; }
  .escape-button { background: none; padding: 4px; }
  .search-subhead { display: flex; justify-content: space-between; padding: 12px 20px 6px; font-size: .72rem; color: var(--muted); }
  .search-subhead .mono { font-size: .6rem; letter-spacing: .1em; color: var(--subtle); }
  #search-results { max-height: 430px; overflow-y: auto; padding: 6px 8px 12px; }
  #search-results :global(a) { display: flex; flex-direction: column; padding: 11px 12px; gap: 3px; border: 1px solid transparent; border-radius: 5px; }
  #search-results :global(a:hover), #search-results :global(a[data-active='true']) { background: var(--surface-hover); border-color: var(--border); }
  #search-results :global(.result-type) { font: .64rem var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--cyan); }
  #search-results :global(.result-title) { font-size: .92rem; font-weight: 550; }
  #search-results :global(.result-description) { font-size: .78rem; line-height: 1.5; color: var(--muted); }
  #search-results :global(.no-results) { padding: 24px 12px; color: var(--muted); text-align: center; }
  .search-footer { padding: 11px 20px; display: flex; justify-content: space-between; align-items: center; color: var(--subtle); font-size: .7rem; border-top: 1px solid var(--border); }
  .search-footer kbd { margin-right: 3px; }
  @media (max-width: 600px) { dialog { margin-top: 7vh; } .search-field { padding: 16px; } }
</style>
