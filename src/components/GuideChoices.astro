---
import type { GuideEntry } from '../lib/archive';
interface Props { presets: NonNullable<GuideEntry['data']['presets']>; id: string; }
const { presets, id } = Astro.props;
---
<section class="guide-section" id="choose-a-preset" data-guide-presets>
  <div class="section-title"><div><span class="eyebrow">Make a choice</span><h2>Choose your starting point</h2></div><span class="count mono">{presets.length} options</span></div>
  <div class="preset-grid">{presets.map((preset, index) => <article class:list={['preset-card', { 'is-recommended': preset.recommended }]}>
    <div class="preset-top"><span class="badge">{preset.codec ?? 'Preset'}</span>{preset.recommended && <span class="badge badge-cyan">Starting point</span>}</div>
    <h3>{preset.title}</h3>{preset.label && <p class="preset-label">{preset.label}</p>}
    <dl><div><dt>Choose it when</dt><dd>{preset.goal}</dd></div><div><dt>Tradeoff</dt><dd>{preset.tradeoff}</dd></div>{preset.compatibility && <div><dt>Playback</dt><dd>{preset.compatibility}</dd></div>}</dl>
    <details class="preset-command"><summary>Command and notes <span class="mono">{preset.language}</span></summary>
      {preset.notes && <p class="command-note">{preset.notes}</p>}
      <div class="command-heading"><span class="mono">{preset.language}</span><button type="button" class="button" data-copy-target={`${id}-preset-${index}`} aria-label={`Copy ${preset.title} command`}>Copy command</button></div>
      <pre id={`${id}-preset-${index}`}><code>{preset.command}</code></pre>
    </details>
  </article>)}</div>
</section>
<style>
  .guide-section { margin-block: 32px; scroll-margin-top: 100px; }
  .section-title { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
  .section-title h2 { margin-top: 7px; font-size: 1.5rem; }
  .count { color: var(--subtle); font-size: .7rem; }
  .preset-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .preset-card { min-width: 0; padding: 22px; border: 1px solid var(--border); background: var(--surface); border-radius: var(--radius); }
  .is-recommended { border-color: var(--cyan); }
  .preset-top { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 18px; }
  h3 { font-size: 1.2rem; line-height: 1.35; }
  .preset-label { margin-top: 6px; font-size: .72rem; color: var(--subtle); }
  dl { margin: 20px 0 0; }
  dl > div { margin-top: 13px; }
  dt { font-size: .68rem; color: var(--subtle); margin-bottom: 4px; }
  dd { margin: 0; font-size: .86rem; line-height: 1.65; color: var(--muted); }
  dl > div:first-child dd { color: var(--text); }
  .preset-command { margin-top: 20px; border-top: 1px solid var(--border); padding-top: 14px; }
  summary { font-size: .8rem; color: var(--text); }
  summary span { color: var(--subtle); font-size: .64rem; margin-left: 8px; }
  .command-note { font-size: .78rem; color: var(--muted); margin-top: 14px; }
  .command-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 16px 0 8px; color: var(--subtle); font-size: .66rem; }
  .command-heading .button { padding: 6px 10px; font-size: .7rem; }
  pre { margin: 0; padding: 14px; border: 1px solid var(--border); background: var(--canvas); border-radius: 5px; font-size: .73rem; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  code { font-size: inherit; }
  @media (max-width: 720px) { .preset-grid { grid-template-columns: 1fr; } .preset-card { padding: 18px; } .count { white-space: nowrap; } }
</style>
