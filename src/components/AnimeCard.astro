---
import type { AnimeEntry } from '../lib/archive';
import { pathFor } from '../lib/archive';
import Icon from './Icon.astro';
interface Props { entry: AnimeEntry; compact?: boolean; }
const { entry, compact = false } = Astro.props;
const d = entry.data;
---
<a href={pathFor('anime', entry.id)} class:list={['anime-card', 'panel', { compact }]} data-archive-card data-type={d.mediaType.toLowerCase()} data-status={d.status.toLowerCase()} data-search={`${d.title} ${d.romajiTitle ?? ''} ${d.japaneseTitle ?? ''} ${d.tags.join(' ')}`.toLowerCase()}>
  <div class="cover"><img src={d.coverImage} alt={`${d.title} cover illustration`} width="600" height="840" loading="lazy"/><span class:list={['media-type', 'badge', d.mediaType === 'MANGA' ? 'badge-violet' : 'badge-cyan']}>{d.mediaType}</span></div>
  <div class="card-info"><div class="card-top"><span class:list={['status', { ongoing: d.status === 'Ongoing', completed: d.status === 'Completed' }]}><i></i>{d.status}</span><Icon name="arrow" size={15}/></div><h3>{d.title}</h3>{d.romajiTitle && d.romajiTitle !== d.title && <p class="romaji">{d.romajiTitle}</p>}<p class="metadata mono">{[d.format, d.season, d.year].filter(Boolean).join(' · ')}</p>{compact && <p class="synopsis">{d.synopsis}</p>}<div class="pill-row tags">{d.tags.slice(0, compact ? 2 : 3).map((tag) => <span class="badge">{tag}</span>)}</div><div class="card-bottom mono"><span>{d.sourceType}{d.defaultCodec && <> <span class="separator">/</span> {d.defaultCodec}</>}</span>{d.totalEpisodes !== undefined && <span>{d.completedEpisodes ?? 0}<span class="separator"> / </span>{d.totalEpisodes} {d.mediaType === 'MANGA' ? 'CH' : 'EP'}</span>}</div></div>
</a>
<style>
  .anime-card { display: flex; flex-direction: column; overflow: hidden; transition: border-color .15s, transform .15s; }
  .anime-card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .cover { position: relative; overflow: hidden; aspect-ratio: 5/6; background: var(--surface-hover); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .anime-card:hover img { transform: scale(1.025); }
  .media-type { position: absolute; top: 12px; left: 12px; font-size: .6rem; background: #080a0e; }
  .card-info { padding: 16px; display: flex; flex-direction: column; flex: 1; }
  .card-top { display: flex; align-items: center; justify-content: space-between; color: var(--subtle); margin-bottom: 10px; }
  .status { color: var(--muted); font: .66rem var(--font-mono); display: flex; gap: 6px; align-items: center; }
  .status i { width: 5px; height: 5px; background: var(--subtle); border-radius: 50%; }
  .ongoing { color: var(--green); } .ongoing i { background: var(--green); }
  .completed i { background: var(--cyan); }
  h3 { font-size: 1.1rem; line-height: 1.35; }
  .anime-card:hover h3 { color: var(--cyan); }
  .romaji { font-size: .75rem; color: var(--subtle); margin-top: 3px; }
  .metadata { color: var(--subtle); font-size: .65rem; margin-top: 8px; }
  .tags { margin-top: 14px; }
  .tags .badge { font: .62rem var(--font-sans); }
  .card-bottom { display: flex; justify-content: space-between; gap: 8px; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border); font-size: .62rem; color: var(--muted); }
  .separator { color: var(--border-strong); }
  .compact { flex-direction: row; }
  .compact .cover { width: 155px; min-height: 225px; flex-shrink: 0; aspect-ratio: auto; }
  .compact .card-info { padding: 18px 20px; min-width: 0; }
  .compact h3 { font-size: 1.22rem; }
  .synopsis { color: var(--muted); font-size: .78rem; line-height: 1.6; margin-top: 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .compact .tags { margin-top: 10px; }
  .compact .card-bottom { margin-top: auto; padding-top: 11px; }
  @media (max-width: 480px) { .compact .cover { width: 105px; } .compact .card-info { padding: 14px; } .compact h3 { font-size: 1.05rem; } .compact .synopsis { -webkit-line-clamp: 2; } .compact .tags { display: none; } .compact .card-bottom { font-size: .57rem; } }
</style>
