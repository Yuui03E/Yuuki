---
import type { AnimeEntry } from '../lib/archive';
import { pathFor } from '../lib/archive';
import Icon from './Icon.astro';
interface Props { entry: AnimeEntry; compact?: boolean; index?: number; }
const { entry, compact = false, index } = Astro.props;
const d = entry.data;
const metadata = [d.format, d.season, d.year].filter(Boolean).join(' · ');
---
<a href={pathFor('anime', entry.id)} class:list={['anime-card', { compact }]} data-archive-card data-type={d.mediaType.toLowerCase()} data-status={d.status.toLowerCase()} data-search={`${d.title} ${d.romajiTitle ?? ''} ${d.japaneseTitle ?? ''} ${d.tags.join(' ')}`.toLowerCase()}>
  <div class="cover"><img src={d.coverImage} alt={`${d.title} cover`} width="600" height="840" loading="lazy"/><span class="media-type mono">{d.mediaType}</span>{index !== undefined && <span class="cover-index mono">{String(index + 1).padStart(2, '0')}</span>}</div>
  <div class="card-info"><div class="card-top"><span class:list={['status', { ongoing: d.status === 'Ongoing', completed: d.status === 'Completed' }]}><i></i>{d.status}</span><Icon name="arrow" size={16}/></div><h3>{d.title}</h3>{d.romajiTitle && d.romajiTitle !== d.title && <p class="romaji">{d.romajiTitle}</p>}{metadata && <p class="metadata mono">{metadata}</p>}{compact && <p class="synopsis">{d.synopsis}</p>}{d.tags.length > 0 && <div class="pill-row tags">{d.tags.slice(0, compact ? 2 : 3).map((tag) => <span class="badge">{tag}</span>)}</div>}<div class="card-bottom mono"><span>{d.sourceType}{d.defaultCodec && <> <span class="separator">/</span> {d.defaultCodec}</>}</span>{d.totalEpisodes !== undefined && <span>{d.completedEpisodes !== undefined && <>{d.completedEpisodes}<span class="separator"> / </span></>}{d.totalEpisodes} {d.mediaType === 'MANGA' ? 'CH' : 'EP'}</span>}</div></div>
</a>
<style>
  .anime-card { display: flex; flex-direction: column; min-width: 0; }
  .cover { position: relative; overflow: hidden; aspect-ratio: 3/4; background: var(--surface-hover); border: 1px solid var(--border-strong); border-radius: 4px; }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .anime-card:hover img { transform: scale(1.025); }
  .media-type, .cover-index { position: absolute; top: 12px; padding: 4px 8px; font-size: .6rem; background: rgb(0 0 0 / 82%); color: #eaf0dd; border: 1px solid rgb(255 255 255 / 20%); border-radius: 3px; }
  .media-type { left: 12px; letter-spacing: .08em; } .cover-index { right: 12px; }
  .card-info { padding: 17px 0 0; display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .card-top { display: flex; align-items: center; justify-content: space-between; color: var(--subtle); margin-bottom: 10px; }
  .status { color: var(--muted); font: .64rem var(--font-mono); display: flex; gap: 7px; align-items: center; }
  .status i { width: 5px; height: 5px; background: var(--subtle); border-radius: 50%; }
  .ongoing { color: var(--green); } .ongoing i { background: var(--green); } .completed i { background: var(--accent); }
  h3 { font-size: 1.15rem; line-height: 1.35; text-wrap: balance; }
  .anime-card:hover h3, .anime-card:hover .card-top > :global(svg) { color: var(--accent); }
  .romaji { font-size: .75rem; color: var(--subtle); margin-top: 4px; }
  .metadata { color: var(--subtle); font-size: .63rem; margin-top: 9px; }
  .tags { margin-top: 14px; } .tags .badge { font: .67rem var(--font-sans); background: transparent; }
  .card-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border); font-size: .61rem; color: var(--muted); }
  .separator { color: var(--subtle); }
  .compact { flex-direction: row; border: 1px solid var(--border); background: var(--surface); border-radius: 4px; overflow: hidden; }
  .compact .cover { width: 140px; flex-shrink: 0; aspect-ratio: auto; border: 0; border-right: 1px solid var(--border); border-radius: 0; }
  .compact .card-info { padding: 20px; }
  .compact h3 { font: 400 1.55rem/1.25 var(--font-display); }
  .synopsis { color: var(--muted); font-size: .79rem; line-height: 1.65; margin-top: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .compact .tags { margin-top: 12px; } .compact .card-bottom { margin-top: auto; padding-top: 14px; }
  .compact:hover { border-color: var(--border-strong); }
  @media (max-width: 1050px) { .compact .cover { width: 110px; } .compact .card-info { padding: 17px; } .compact h3 { font-size: 1.35rem; } }
  @media (max-width: 480px) { .compact .cover { width: 99px; } .compact .card-info { padding: 16px; } .compact h3 { font-size: 1.25rem; } .compact .tags { display: none; } .compact .card-bottom { margin-top: 14px; font-size: .56rem; } }
</style>
