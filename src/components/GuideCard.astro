---
import type { GuideEntry } from '../lib/archive';
import { formatDate, pathFor } from '../lib/archive';
import Icon from './Icon.astro';
interface Props { entry: GuideEntry; index?: number; }
const { entry, index } = Astro.props;
const d = entry.data;
---
<a class="guide-card" href={pathFor('guides', entry.id)} data-guide-card data-category={d.category.toLowerCase()} data-search={[d.title, d.description, d.summary, ...d.tags].filter(Boolean).join(' ').toLowerCase()}>
  <div class="guide-top"><span class="guide-category mono">{d.category}</span>{index !== undefined ? <span class="index mono">{String(index + 1).padStart(2, '0')} /</span> : <Icon name="book" size={19}/>}</div><h3>{d.title}</h3><p>{d.description}</p><div class="guide-bottom"><span>{d.difficulty}</span><time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time><Icon name="arrow" size={17}/></div>
</a>
<style>
  .guide-card { display: flex; flex-direction: column; min-width: 0; padding: 25px; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; transition: border-color .15s; }
  .guide-card:hover { border-color: var(--border-strong); }
  .guide-top { display: flex; justify-content: space-between; align-items: center; color: var(--subtle); margin-bottom: 21px; }
  .guide-category { font-size: .63rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .index { font-size: .75rem; }
  h3 { font: 400 1.65rem/1.28 var(--font-display); letter-spacing: -.04em; text-wrap: balance; }
  .guide-card:hover h3 { color: var(--accent); }
  p { margin-top: 13px; color: var(--muted); font-size: .84rem; line-height: 1.8; }
  .guide-bottom { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: auto; padding-top: 26px; font-size: .68rem; color: var(--subtle); }
  .guide-bottom > span { color: var(--muted); } time { margin-left: auto; } .guide-bottom :global(svg) { color: var(--accent); }
  @media (max-width: 480px) { .guide-card { padding: 21px; } h3 { font-size: 1.5rem; } .guide-bottom { font-size: .65rem; } }
</style>
