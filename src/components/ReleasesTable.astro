---
import type { AnimeEntry, EpisodeEntry } from '../lib/archive';
import { audioSummary, episodeCaption, formatDate, pathFor, releaseTitle } from '../lib/archive';
import Icon from './Icon.astro';
interface Props { episodes: EpisodeEntry[]; anime: AnimeEntry[]; id?: string; }
const { episodes, anime, id = 'releases' } = Astro.props;
const seriesMap = new Map(anime.map((entry) => [entry.id, entry]));
const sourceFor = (entry: EpisodeEntry) => entry.data.source ?? seriesMap.get(entry.data.anime.id)?.data.sourceType;
const filtersFor = (entry: EpisodeEntry) => {
  const source = sourceFor(entry)?.toLowerCase() ?? '';
  const codec = entry.data.videoCodec ?? '';
  return [source.includes('bd') ? 'bd' : '', source.includes('web') ? 'web' : '', /av1/i.test(codec) ? 'av1' : '', /hevc|x265|h\.265/i.test(codec) ? 'hevc' : '', /avc|x264|h\.264/i.test(codec) ? 'avc' : '', entry.data.isBatch ? 'batch' : ''].filter(Boolean);
};
const availableFilters = new Set(episodes.flatMap(filtersFor));
const pills = ['All', 'BD', 'WEB', 'AV1', 'HEVC', 'AVC', 'Batch'].filter((pill) => pill === 'All' || availableFilters.has(pill.toLowerCase()));
const columns = {
  source: episodes.some((entry) => sourceFor(entry)),
  resolution: episodes.some((entry) => entry.data.resolution),
  video: episodes.some((entry) => entry.data.videoCodec || entry.data.bitDepth !== undefined),
  audio: episodes.some((entry) => audioSummary(entry)),
  size: episodes.some((entry) => entry.data.fileSize),
};
---
<div class="release-table" data-release-table id={id}>
  <div class="table-toolbar" data-pagefind-ignore><div class="pill-row" role="group" aria-label="Filter releases">{pills.map((pill) => <button type="button" class="filter-pill" data-filter={pill.toLowerCase()} aria-pressed={pill === 'All'}>{pill}</button>)}</div><div class="table-search"><Icon name="search" size={16}/><label class="sr-only" for={`${id}-search`}>Search releases</label><input id={`${id}-search`} type="search" placeholder="Title, source, or codec…" data-release-search /></div></div>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Release list with file details and links.">
    <table><caption class="sr-only">Yuuki episode and batch releases, newest first</caption><thead><tr><th scope="col">Release</th>{columns.source && <th scope="col">Source</th>}{columns.resolution && <th scope="col">Resolution</th>}{columns.video && <th scope="col">Video</th>}{columns.audio && <th scope="col">Audio</th>}{columns.size && <th scope="col">Size</th>}<th scope="col">Released</th><th scope="col" class="links-head">Links</th></tr></thead><tbody>{episodes.map((entry) => {
      const d = entry.data;
      const series = seriesMap.get(d.anime.id);
      const source = sourceFor(entry);
      const image = d.thumbnail ?? series?.data.coverImage;
      return <tr data-release-row data-search={`${releaseTitle(entry, series)} ${d.title ?? ''} ${source ?? ''} ${d.videoCodec ?? ''} ${d.resolution ?? ''} ${d.version}`.toLowerCase()} data-filters={filtersFor(entry).join(' ')}>
        <td class="release-name"><a href={pathFor('releases', entry.id)}>{image && <img class="release-cover" src={image} alt="" width="48" height="64" loading="lazy"/>}<span class="name-copy"><span class="title">{series?.data.title ?? d.title ?? 'Release'}</span><span class="release-secondary"><span class="tag mono">{d.releaseTag}</span><span class="episode">{episodeCaption(entry)}</span><span class="version mono">{d.version}</span></span></span></a>{d.title && <span class="episode-title">{d.title}</span>}</td>
        {columns.source && <td class="file-fact" data-label="Source">{source && <span class="badge">{source}</span>}</td>}{columns.resolution && <td class="file-fact mono" data-label="Resolution">{d.resolution && <span>{d.resolution}</span>}</td>}{columns.video && <td class="file-fact" data-label="Video">{d.videoCodec && <span class="badge badge-cyan">{d.videoCodec}</span>}{d.bitDepth !== undefined && <span class="depth mono">{d.bitDepth}-bit</span>}</td>}{columns.audio && <td class="file-fact mono" data-label="Audio">{audioSummary(entry) && <span>{audioSummary(entry)}</span>}</td>}{columns.size && <td class="file-fact mono" data-label="Size">{d.fileSize && <span>{d.fileSize}</span>}</td>}<td class="date"><time datetime={d.releaseDate.toISOString()}>{formatDate(d.releaseDate)}</time></td><td class="release-links">{d.downloads?.slice(0, 3).map((download) => <a href={download.url} class="download-link" title={download.label} aria-label={`${download.label} for ${releaseTitle(entry, series)}`} target={download.isMagnet ? undefined : '_blank'} rel="noreferrer"><Icon name={download.isMagnet ? 'magnet' : 'download'} size={16}/></a>)}<a class="download-link detail-link" href={pathFor('releases', entry.id)} aria-label={`Details for ${releaseTitle(entry, series)}`} title="Release details"><Icon name="arrow" size={17}/></a></td>
      </tr>;
    })}</tbody></table>
  </div>
  <p class="table-empty" data-release-empty hidden={episodes.length > 0}>{episodes.length ? 'No releases match these filters.' : 'No published releases yet.'}</p>
  <div class="table-bottom mono" data-pagefind-ignore><span data-release-count aria-live="polite">{episodes.length} releases</span><span>NEWEST FIRST <span class="cyan">↓</span></span></div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-release-table]').forEach((table) => {
    const input = table.querySelector<HTMLInputElement>('[data-release-search]');
    const rows = Array.from(table.querySelectorAll<HTMLElement>('[data-release-row]'));
    const buttons = Array.from(table.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    let filter = 'all';
    const apply = () => {
      const words = (input?.value.toLowerCase().trim() ?? '').split(/\s+/).filter(Boolean);
      let count = 0;
      rows.forEach((row) => {
        const show = words.every((word) => row.dataset.search?.includes(word)) && (filter === 'all' || row.dataset.filters?.split(' ').includes(filter));
        row.hidden = !show;
        if (show) count++;
      });
      const label = table.querySelector('[data-release-count]');
      if (label) label.textContent = `${count} of ${rows.length} releases`;
      const empty = table.querySelector<HTMLElement>('[data-release-empty]');
      if (empty) empty.hidden = count > 0;
    };
    input?.addEventListener('input', apply);
    buttons.forEach((button) => button.addEventListener('click', () => {
      filter = button.dataset.filter ?? 'all';
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      apply();
    }));
    apply();
  });
</script>
<style>
  .table-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 15px; padding: 12px 0; border-block: 1px solid var(--border); margin-bottom: 16px; }
  .table-search { display: flex; align-items: center; gap: 9px; margin-left: auto; width: 265px; color: var(--subtle); }
  .table-search input { background: transparent; font-size: .8rem; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 4px; }
  table { min-width: 1060px; }
  th { color: var(--subtle); font: .61rem var(--font-mono); padding: 13px 12px; border-bottom: 1px solid var(--border); background: var(--surface); text-transform: uppercase; letter-spacing: .05em; }
  td { padding: 18px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; white-space: nowrap; }
  tbody tr:last-child td { border-bottom: 0; } tbody tr:hover { background: var(--surface-hover); }
  .release-name { min-width: 275px; max-width: 380px; }
  .release-name a { display: flex; align-items: center; gap: 12px; }
  .release-cover { width: 40px; height: 56px; flex-shrink: 0; border-radius: 3px; object-fit: cover; }
  .name-copy { min-width: 0; display: block; }
  .title { display: block; font-size: .85rem; line-height: 1.5; font-weight: 600; white-space: normal; }
  .release-name a:hover .title { color: var(--accent); }
  .release-secondary { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; margin-top: 5px; font-size: .66rem; color: var(--muted); white-space: normal; }
  .tag { color: var(--accent); font-size: .61rem; } .version { font-size: .6rem; color: var(--subtle); }
  .episode-title { display: block; white-space: normal; font-size: .67rem; color: var(--subtle); margin: 6px 0 0 52px; }
  .file-fact { font-size: .67rem; color: var(--muted); } .file-fact .badge { font-size: .61rem; }
  .date { font-size: .69rem; color: var(--muted); }
  .depth { display: block; font-size: .6rem; color: var(--subtle); margin-top: 4px; }
  .links-head, .release-links { text-align: right; }
  .download-link { display: inline-grid; place-items: center; width: 34px; height: 44px; border-radius: 4px; color: var(--accent); }
  .download-link:hover { background: var(--accent-wash); } .detail-link { color: var(--muted); }
  .table-bottom { display: flex; justify-content: space-between; gap: 14px; padding: 13px 0; color: var(--subtle); font-size: .61rem; }
  .table-empty { padding: 25px; text-align: center; color: var(--muted); border-bottom: 1px solid var(--border); }
  @media (max-width: 1000px) {
    .table-scroll { overflow: visible; border: 0; border-radius: 0; }
    table, tbody { display: block; min-width: 0; width: 100%; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
    tbody tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 18px; align-items: center; padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; margin-bottom: 12px; }
    td { display: flex; align-items: center; gap: 6px; padding: 0; border: 0; white-space: normal; }
    .release-name { display: block; grid-column: 1/-1; min-width: 0; max-width: none; padding-bottom: 8px; }
    .release-cover { width: 45px; height: 63px; } .title { font-size: .98rem; } .release-secondary { font-size: .7rem; } .episode-title { margin-left: 57px; }
    .file-fact { font-size: .7rem; flex-wrap: wrap; min-width: 0; overflow-wrap: anywhere; } .file-fact:empty { display: none; } .file-fact::before { content: attr(data-label); font: .66rem var(--font-sans); color: var(--subtle); } .file-fact .badge { white-space: normal; max-width: 100%; overflow-wrap: anywhere; }
    .depth { display: inline; margin-top: 0; } .date { grid-column: 1; min-width: 0; align-self: stretch; border-top: 1px solid var(--border); margin-top: 3px; padding-top: 14px; }
    .release-links { grid-column: 2; flex-wrap: wrap; justify-content: flex-end; gap: 6px; border-top: 1px solid var(--border); margin-top: 3px; padding-top: 8px; }
    .download-link { width: 40px; height: 40px; border: 1px solid var(--border); } .detail-link { color: var(--accent); }
    .table-bottom { padding-top: 5px; }
  }
  @media (max-width: 760px) { .table-toolbar { gap: 10px; } .table-search { width: 100%; margin: 0; } tbody tr { padding: 17px; gap: 10px 14px; } }
</style>
