---
import '../styles/tokens.css';
import Icon from '../components/Icon.astro';
import CommandPalette from '../components/CommandPalette.astro';
import AppearanceSettings from '../components/AppearanceSettings.astro';
import SiteBackdrop from '../components/SiteBackdrop.astro';
import { appearanceBootstrap } from '../lib/appearance';
interface Props { title: string; description?: string; searchable?: boolean; searchType?: string; image?: string; adult?: boolean; noindex?: boolean; }
const { adult = false, searchType = 'Page' } = Astro.props;
const title = adult ? 'Adult area' : Astro.props.title;
const description = adult ? 'Adult content. A deliberate choice is required before media loads.' : Astro.props.description ?? 'An independent anime and manga archive by Yuuki. Releases, source notes, frame comparisons, and practical encoding guides.';
const image = adult ? undefined : Astro.props.image;
const searchable = !adult && Astro.props.searchable === true;
const AdultGate = adult ? (await import('../components/AdultGate.astro')).default : null;
const path = Astro.url.pathname;
const links = [{ href: '/', label: 'Home' }, { href: '/anime/', label: 'Archive' }, { href: '/releases/', label: 'Releases' }, { href: '/guides/', label: 'Guides' }, { href: '/comparisons/', label: 'Compare' }, { href: '/about/', label: 'About' }];
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="en" data-theme="dark" data-font="editorial" data-background="contour" data-grain="0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Home' ? 'Yuuki — Anime Encoding Archive' : `${title} · Yuuki`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <script is:inline set:html={appearanceBootstrap} />
    {(adult || Astro.props.noindex) && <meta name="robots" content="noindex, nofollow"/>}
    <meta property="og:title" content={`${title} · Yuuki`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <SiteBackdrop />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="container nav-shell">
        <a class="brand" href="/" aria-label="Yuuki home"><svg viewBox="0 0 32 36" width="28" height="32" fill="none" aria-hidden="true"><path d="M6 4H2v28h4m20-28h4v28h-4M8 9l8 12 8-12M16 21v7" stroke="currentColor" stroke-width="1.7"/></svg><span class="brand-word">Yuuki<span class="brand-caption">ENCODING JOURNAL</span></span></a>
        <nav class="desktop-nav" aria-label="Main navigation">{links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
        <div class="nav-actions"><button type="button" class="search-trigger" data-search-open aria-label="Search the archive (Ctrl+K)"><Icon name="search"/><span>Search archive</span><kbd>Ctrl K</kbd></button><button type="button" class="icon-button theme-toggle" aria-label="Switch color theme" data-theme-toggle><span class="sun-icon"><Icon name="sun"/></span><span class="moon-icon"><Icon name="moon"/></span></button><details class="mobile-menu"><summary aria-label="Open navigation"><Icon name="menu" size={20}/></summary><nav aria-label="Mobile navigation">{links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav></details></div>
      </div>
    </header>
    <main id="main" class="container" data-pagefind-body={searchable ? true : undefined} data-pagefind-ignore={!searchable ? 'all' : undefined} data-pagefind-filter={searchable ? `type:${searchType}` : undefined}>{AdultGate ? <AdultGate><slot /></AdultGate> : <slot />}</main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="container">
        <div class="footer-main">
          <div><a class="footer-brand" href="/">Yuuki<span> /</span></a><p>A personal archive.<br/>Care in every frame.</p></div>
          <nav class="footer-nav" aria-label="Footer navigation"><a href="/anime/">Explore the archive <Icon name="arrow" size={14}/></a><a href="/guides/">Read the field notes <Icon name="arrow" size={14}/></a><a href="/about/#progress">Follow the work <Icon name="arrow" size={14}/></a></nav>
          <div class="footer-extra"><a href="/adult/">Adult area · 18+</a>{import.meta.env.DEV && <a href="/studio/" class="studio-link">Local studio <Icon name="external" size={12}/></a>}</div>
        </div>
        <AppearanceSettings />
        <div class="footer-bottom mono"><span>ANIME · MANGA · ENCODING</span><span class="footer-clock" data-local-clock hidden><Icon name="clock" size={12}/><time></time></span><span>© {new Date().getUTCFullYear()} Yuuki</span></div>
      </div>
    </footer>
    <CommandPalette />
  </body>
</html>
<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: var(--canvas); border-bottom: 1px solid var(--border); }
  .nav-shell { display: flex; align-items: center; gap: 46px; min-height: 84px; }
  .brand { display: flex; align-items: center; gap: 11px; flex-shrink: 0; color: var(--accent); }
  .brand-word { font-weight: 700; font-size: 1.9rem; line-height: 1; letter-spacing: -.075em; color: var(--text); }
  .brand-caption { display: block; margin-top: 7px; font: .48rem var(--font-mono); letter-spacing: .15em; color: var(--subtle); }
  .desktop-nav { display: flex; align-self: stretch; gap: 23px; }
  nav a { color: var(--muted); font-size: .8rem; }
  .desktop-nav a { position: relative; display: flex; align-items: center; }
  nav a:hover, nav a[aria-current] { color: var(--text); }
  .desktop-nav a[aria-current]::after { content: ''; position: absolute; bottom: 18px; height: 3px; width: 3px; border-radius: 50%; background: var(--accent); left: calc(50% - 1px); }
  .nav-actions { display: flex; align-items: center; gap: 9px; margin-left: auto; }
  .search-trigger { display: flex; align-items: center; gap: 10px; height: 44px; padding: 0 12px; border: 1px solid var(--border); border-radius: 4px; background: var(--surface); color: var(--muted); font-size: .75rem; }
  .search-trigger:hover { border-color: var(--border-strong); color: var(--muted); }
  .search-trigger kbd { margin-left: 14px; font-size: .6rem; }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--border); border-radius: 4px; list-style: none; color: var(--muted); }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu nav { display: flex; flex-direction: column; gap: 0; position: absolute; right: 0; top: 54px; width: 210px; padding: 8px 16px; border: 1px solid var(--border-strong); background: var(--surface); border-radius: 6px; box-shadow: var(--shadow); }
  .mobile-menu nav a { display: flex; align-items: center; min-height: 44px; border-bottom: 1px solid var(--border); }
  .mobile-menu nav a:last-child { border: 0; }
  .mobile-menu[open] summary { color: var(--accent); border-color: var(--border-strong); }
  .moon-icon { display: none; }
  :global([data-theme='light']) .sun-icon { display: none; }
  :global([data-theme='light']) .moon-icon { display: inline; }
  main { min-height: 45vh; }
  .site-footer { margin-top: 64px; border-top: 1px solid var(--border); color: var(--subtle); }
  .footer-main { display: grid; grid-template-columns: 1.4fr 1fr auto; gap: 40px; align-items: start; padding: 32px 0; }
  .footer-brand { font-size: 2.9rem; color: var(--text); font-weight: 700; letter-spacing: -.08em; line-height: 1; }
  .footer-brand span { color: var(--accent); font-family: var(--font-display); font-style: italic; font-weight: 400; }
  .footer-main p { font-size: .78rem; line-height: 1.7; margin-top: 12px; }
  .footer-nav { display: grid; gap: 4px; }
  .footer-nav a { display: flex; align-items: center; gap: 18px; min-height: 36px; }
  .footer-nav :global(svg) { color: var(--subtle); margin-left: auto; }
  .footer-extra { display: grid; gap: 10px; font-size: .73rem; padding-top: 9px; }
  .footer-extra a:hover { color: var(--accent); }
  .footer-bottom { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: center; border-top: 1px solid var(--border); padding: 17px 0 22px; font-size: .6rem; letter-spacing: .07em; }
  .footer-bottom > span:last-child { grid-column: 3; justify-self: end; }
  .footer-clock { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); letter-spacing: .03em; }
  .footer-clock time { color: var(--text); font-variant-numeric: tabular-nums; }
  .studio-link { display: flex; gap: 6px; align-items: center; color: var(--violet); }
  .skip-link { position: fixed; left: 16px; top: -80px; padding: 10px 15px; background: var(--cyan); color: var(--canvas); z-index: 100; border-radius: 4px; }
  .skip-link:focus { top: 10px; }
  @media (max-width: 1100px) { .nav-shell { gap: 30px; } .desktop-nav { gap: 18px; } .search-trigger span { display: none; } .search-trigger kbd { margin-left: 4px; } }
  @media (max-width: 850px) { .nav-shell { min-height: 72px; gap: 12px; } .desktop-nav { display: none; } .mobile-menu { display: block; } .search-trigger { width: 44px; padding: 0; justify-content: center; } .search-trigger kbd { display: none; } }
  @media (max-width: 760px) { .nav-actions { gap: 6px; } .brand { gap: 8px; } .brand-word { font-size: 1.7rem; } .brand-caption { font-size: .42rem; } .footer-main { grid-template-columns: 1fr 1fr; gap: 24px; } .footer-extra { grid-column: 1/-1; display: flex; justify-content: space-between; } .footer-bottom { font-size: .53rem; } }
  @media (max-width: 600px) { .footer-bottom { grid-template-columns: 1fr auto; gap: 12px; } .footer-bottom > span:last-child { grid-column: 2; grid-row: 1; } .footer-clock { grid-column: 1/-1; grid-row: 2; justify-self: start; font-size: .6rem; } }
  @media (max-width: 360px) { .brand > svg { display: none; } .footer-main { grid-template-columns: 1fr; gap: 20px; } }
</style>
