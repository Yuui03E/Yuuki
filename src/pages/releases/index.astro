---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ReleasesTable from '../../components/ReleasesTable.astro';
import { getArchive } from '../../lib/archive';
const { anime, episodes } = await getArchive();
---
<BaseLayout title="Release index" description="Yuuki’s episode and batch releases, with download links, source notes, and available file specifications.">
  <PageIntro eyebrow="The release desk / episodes & batches" title="Fresh from the workbench." description="Find a release, check the file details, and follow its links. The source notes and comparisons stay with the post." count={episodes.length} countLabel="published releases"/>
  <ReleasesTable anime={anime} episodes={episodes}/>
  <p class="release-note">Source and codec filters work together with search. Open a release for its complete notes and available downloads.</p>
</BaseLayout>
<style>.release-note { margin-top: 18px; font-size: .76rem; color: var(--subtle); max-width: 700px; }</style>
