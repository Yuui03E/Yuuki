---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrameCompare from '../../components/FrameCompare.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import TechAccordion from '../../components/TechAccordion.astro';
import Icon from '../../components/Icon.astro';
import { getArchive, releaseTitle, formatDate, pathFor } from '../../lib/archive';
export async function getStaticPaths() { const archive = await getArchive(); return archive.episodes.map((entry) => ({ params: { id: entry.id }, props: { entry, series: archive.anime.find((anime) => anime.id === entry.data.anime.id)! } })); }
const { entry, series } = Astro.props;
const d = entry.data;
const title = releaseTitle(entry, series);
const { Content } = await render(entry);
const specs = [ ['Source', d.source], ['Container', d.container], ['Resolution', d.resolution], ['Frame rate', d.frameRate], ['Video codec', d.videoCodec], ['Profile', d.videoProfile], ['Bit depth', d.bitDepth !== undefined ? `${d.bitDepth}-bit` : undefined], ['Bitrate', d.bitrate], ['File size', d.fileSize], ['CRC32', d.crc32] ].filter(([, value]) => value !== undefined && value !== '');
const audioTracks = (d.audioTracks ?? []).filter((track) => Object.values(track).some((value) => value !== undefined && value !== false));
const subtitleTracks = (d.subtitleTracks ?? []).filter((track) => Object.values(track).some((value) => value !== undefined && value !== false));
---
<BaseLayout title={title} description={`Release notebook for ${title}. Source details, encoding parameters, screenshots, and frame comparisons.`} searchable searchType="Release"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/releases/">Releases</a><span>/</span><a href={pathFor('anime', series.id)}>{series.data.title}</a></div><header class="release-header"><span class="eyebrow">Release notebook / {d.isBatch ? 'Batch' : 'Episode'}</span><h1 data-pagefind-meta="title">{title}</h1>{d.title && <p>{d.title}</p>}<div class="pill-row"><span class="badge badge-cyan">{d.version}</span>{d.videoCodec && <span class="badge badge-violet">{d.videoCodec}</span>}{d.resolution && <span class="badge">{d.resolution}</span>}<time class="release-date mono" datetime={d.releaseDate.toISOString()}>{formatDate(d.releaseDate)}</time></div></header><div class="release-layout"><article><section class="release-section"><div class="section-heading"><h2>Release notes</h2></div><div class="prose"><Content/></div></section>{audioTracks.length > 0 && <section class="release-section"><h2>Audio tracks</h2><div class="tracks">{audioTracks.map((track, index) => <div class="track panel"><span class="track-number mono">{String(index + 1).padStart(2, '0')}</span><span>{[track.language, track.codec, track.channels, track.bitrate, track.title].filter(Boolean).join(' · ')}</span>{track.isDefault && <span class="badge">Default</span>}</div>)}</div></section>}{subtitleTracks.length > 0 && <section class="release-section"><h2>Subtitle tracks</h2><div class="tracks">{subtitleTracks.map((track, index) => <div class="track panel"><span class="track-number mono">{String(index + 1).padStart(2, '0')}</span><span>{[track.language, track.format, track.title].filter(Boolean).join(' · ')}</span>{track.isDefault && <span class="badge">Default</span>}{track.forced && <span class="badge">Forced</span>}</div>)}</div></section>}{(d.encoderParams || d.filterScript || d.mediainfo) && <section class="release-section"><h2>The technical notebook</h2><div class="tech-blocks"><TechAccordion title="Encoder parameters" code={d.encoderParams} id={`${entry.id}-encoder`} language="CLI"/><TechAccordion title="VapourSynth filter script" code={d.filterScript} id={`${entry.id}-filter`} language="PYTHON"/><TechAccordion title="MediaInfo" code={d.mediainfo} id={`${entry.id}-mediainfo`} language="TEXT"/></div></section>}{d.screenshots && d.screenshots.length > 0 && <section class="release-section"><h2>Screenshots</h2><ScreenshotGallery screenshots={d.screenshots} id={entry.id}/></section>}{d.comparisons && d.comparisons.length > 0 && <section class="release-section"><h2>Source / encode inspection</h2><div class="comparison-stack">{d.comparisons.map((comparison, index) => <FrameCompare comparison={comparison} id={`${entry.id.replace(/\//g, '-')}-${index}`}/>)}</div></section>}{d.changelog && d.changelog.length > 0 && <section class="release-section"><h2>Changelog</h2><div class="changelog">{d.changelog.map((change) => <div><span class="badge badge-cyan">{change.version}</span><time class="mono subtle" datetime={change.date.toISOString()}>{formatDate(change.date)}</time><p>{change.notes}</p></div>)}</div></section>}</article><aside class="release-sidebar">{specs.length > 0 && <section class="specs panel"><h2>File specifications</h2><dl>{specs.map(([label, value]) => <div><dt>{label}</dt><dd class="mono">{value}</dd></div>)}</dl></section>}{d.downloads && d.downloads.length > 0 && <section class="downloads panel"><h2>Download links</h2>{d.downloads.map((download) => <a class="button" href={download.url} target={download.isMagnet ? undefined : '_blank'} rel="noreferrer"><Icon name={download.isMagnet ? 'magnet' : 'download'} size={15}/><span>{download.label}{download.provider && <small>{download.provider}</small>}</span><Icon name="external" size={12}/></a>)}</section>}<a href={pathFor('anime', series.id)} class="series-link panel"><img src={series.data.coverImage} width="60" height="84" alt="" loading="lazy"/><div><span class="mono subtle">IN THE ARCHIVE</span><strong>{series.data.title}</strong></div><Icon name="arrow" size={14}/></a></aside></div></BaseLayout>
<style>
  .release-header { padding-bottom: 25px; border-bottom: 1px solid var(--border); } h1 { font-size: clamp(1.75rem, 3vw, 2.7rem); margin: 13px 0; } .release-header > p { color: var(--muted); margin-bottom: 17px; } .release-date { color: var(--subtle); font-size: .7rem; margin-left: 10px; }
  .release-layout { display: grid; grid-template-columns: minmax(0, 1fr) 315px; gap: 32px; margin-top: 25px; } .release-sidebar { align-self: start; position: sticky; top: 98px; }
  .release-section + .release-section { margin-top: 30px; } .release-section > h2 { margin-bottom: 14px; } .tracks, .tech-blocks, .comparison-stack { display: grid; gap: 10px; }
  .track { display: flex; gap: 12px; align-items: center; padding: 11px 15px; font-size: .78rem; color: var(--muted); } .track-number { color: var(--cyan); } .track .badge { margin-left: auto; }
  .specs, .downloads { padding: 18px; } .release-sidebar h2 { font-size: 1rem; } dl { margin: 14px 0 0; } dl div { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid var(--border); padding: 9px 0; font-size: .73rem; } dt { color: var(--subtle); } dd { margin: 0; text-align: right; overflow-wrap: anywhere; font-size: .69rem; }
  .downloads { margin-top: 16px; } .downloads .button { width: 100%; margin-top: 12px; justify-content: flex-start; } .downloads .button > svg:last-child { margin-left: auto; } .downloads small { display: block; color: var(--subtle); font-size: .65rem; margin-top: 3px; }
  .series-link { margin-top: 16px; display: flex; align-items: center; gap: 12px; padding: 12px; } .series-link img { width: 42px; height: 58px; border-radius: 3px; object-fit: cover; } .series-link span { font-size: .55rem; } .series-link strong { display: block; font-size: .8rem; margin-top: 4px; } .series-link > svg { margin-left: auto; color: var(--cyan); }
  .changelog > div { padding: 13px 0; border-top: 1px solid var(--border); } .changelog time { margin-left: 12px; font-size: .65rem; } .changelog p { margin-top: 8px; color: var(--muted); font-size: .8rem; }
  @media (max-width: 1000px) { .release-layout { grid-template-columns: minmax(0, 1fr) 270px; gap: 22px; } } @media (max-width: 760px) { .release-layout { display: flex; flex-direction: column-reverse; } .release-sidebar { position: static; width: 100%; } .track { flex-wrap: wrap; } }
</style>
