---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrameCompare from '../../components/FrameCompare.astro';
import VideoGallery from '../../components/VideoGallery.astro';
import { isAdult } from '../../lib/audience.mjs';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import TechAccordion from '../../components/TechAccordion.astro';
import Icon from '../../components/Icon.astro';
import { getArchive, releaseTitle, formatDate, pathFor } from '../../lib/archive';
export async function getStaticPaths() { const archive = await getArchive({ audience: 'all' }); return archive.episodes.map((entry) => ({ params: { id: entry.id }, props: { entry, series: archive.anime.find((anime) => anime.id === entry.data.anime.id)! } })); }
const { entry, series } = Astro.props;
const d = entry.data;
const title = releaseTitle(entry, series);
const { Content } = await render(entry);
const specs = [ ['Source', d.source], ['Container', d.container], ['Resolution', d.resolution], ['Frame rate', d.frameRate], ['Video codec', d.videoCodec], ['Profile', d.videoProfile], ['Bit depth', d.bitDepth !== undefined ? `${d.bitDepth}-bit` : undefined], ['Bitrate', d.bitrate], ['File size', d.fileSize], ['CRC32', d.crc32] ].filter(([, value]) => value !== undefined && value !== '');
const audioTracks = (d.audioTracks ?? []).filter((track) => Object.values(track).some((value) => value !== undefined && value !== false));
const subtitleTracks = (d.subtitleTracks ?? []).filter((track) => Object.values(track).some((value) => value !== undefined && value !== false));
---
<BaseLayout title={title} description={`Release notebook for ${title}. Source details, encoding parameters, screenshots, and frame comparisons.`} adult={isAdult(d, series.data)} searchable searchType="Release"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/releases/">Releases</a><span>/</span><a href={pathFor('anime', series.id)}>{series.data.title}</a></div><header class="release-header"><a class="release-cover-link" href={pathFor('anime', series.id)} aria-label={`View ${series.data.title} in the archive`}><img src={series.data.coverImage} alt="" width="120" height="168"/></a><div class="release-heading-copy"><span class="eyebrow">Release notebook / {d.isBatch ? 'Batch' : 'Episode'}</span><h1 data-pagefind-meta="title">{title}</h1>{d.title && <p>{d.title}</p>}<div class="pill-row"><span class="badge badge-cyan">{d.version}</span>{d.videoCodec && <span class="badge badge-violet">{d.videoCodec}</span>}{d.resolution && <span class="badge">{d.resolution}</span>}<time class="release-date mono" datetime={d.releaseDate.toISOString()}>{formatDate(d.releaseDate)}</time></div></div></header><nav class="release-jumps" aria-label="Release sections"><a href="#release-notes">Release notes</a>{(d.downloads?.length ?? 0) > 0 && <a href="#release-downloads">Downloads <Icon name="download" size={13}/></a>}{(d.screenshots?.length ?? 0) > 0 && <a href="#release-screenshots">Screenshots</a>}{(d.comparisons?.length ?? 0) > 0 && <a href="#release-comparisons">Compare frames</a>}{(d.encoderParams || d.filterScript || d.mediainfo) && <a href="#technical-notebook">Technical notebook</a>}</nav><div class="release-layout"><article><section class="release-section" id="release-notes"><div class="section-heading"><h2>Release notes</h2></div><div class="prose"><Content/></div></section>{audioTracks.length > 0 && <section class="release-section"><h2>Audio tracks</h2><div class="tracks">{audioTracks.map((track, index) => <div class="track panel"><span class="track-number mono">{String(index + 1).padStart(2, '0')}</span><span>{[track.language, track.codec, track.channels, track.bitrate, track.title].filter(Boolean).join(' · ')}</span>{track.isDefault && <span class="badge">Default</span>}</div>)}</div></section>}{subtitleTracks.length > 0 && <section class="release-section"><h2>Subtitle tracks</h2><div class="tracks">{subtitleTracks.map((track, index) => <div class="track panel"><span class="track-number mono">{String(index + 1).padStart(2, '0')}</span><span>{[track.language, track.format, track.title].filter(Boolean).join(' · ')}</span>{track.isDefault && <span class="badge">Default</span>}{track.forced && <span class="badge">Forced</span>}</div>)}</div></section>}{(d.encoderParams || d.filterScript || d.mediainfo) && <section class="release-section" id="technical-notebook"><h2>The technical notebook</h2><div class="tech-blocks"><TechAccordion title="Encoder parameters" code={d.encoderParams} id={`${entry.id}-encoder`} language="CLI"/><TechAccordion title="VapourSynth filter script" code={d.filterScript} id={`${entry.id}-filter`} language="PYTHON"/><TechAccordion title="MediaInfo" code={d.mediainfo} id={`${entry.id}-mediainfo`} language="TEXT"/></div></section>}{d.screenshots && d.screenshots.length > 0 && <section class="release-section" id="release-screenshots"><h2>Screenshots</h2><ScreenshotGallery screenshots={d.screenshots} id={entry.id}/></section>}{d.comparisons && d.comparisons.length > 0 && <section class="release-section" id="release-comparisons"><h2>Source / encode inspection</h2><div class="comparison-stack">{d.comparisons.map((comparison, index) => <FrameCompare comparison={comparison} id={`${entry.id.replace(/\//g, '-')}-${index}`}/>)}</div></section>}{d.videos && d.videos.length > 0 && <section class="release-section"><h2>Videos and trailers</h2><VideoGallery videos={d.videos}/></section>}{d.changelog && d.changelog.length > 0 && <section class="release-section"><h2>Changelog</h2><div class="changelog">{d.changelog.map((change) => <div><span class="badge badge-cyan">{change.version}</span><time class="mono subtle" datetime={change.date.toISOString()}>{formatDate(change.date)}</time><p>{change.notes}</p></div>)}</div></section>}</article><aside class="release-sidebar">{d.downloads && d.downloads.length > 0 && <section class="downloads panel" id="release-downloads"><h2>Download links</h2>{d.downloads.map((download) => <a class="button" href={download.url} target={download.isMagnet ? undefined : '_blank'} rel="noreferrer"><Icon name={download.isMagnet ? 'magnet' : 'download'} size={15}/><span>{download.label}{download.provider && <small>{download.provider}</small>}</span><Icon name="external" size={12}/></a>)}</section>}{specs.length > 0 && <section class="specs panel"><h2>File specifications</h2><dl>{specs.map(([label, value]) => <div><dt>{label}</dt><dd class="mono">{value}</dd></div>)}</dl></section>}<a href={pathFor('anime', series.id)} class="series-link panel"><img src={series.data.coverImage} width="60" height="84" alt="" loading="lazy"/><div><span class="mono subtle">IN THE ARCHIVE</span><strong>{series.data.title}</strong></div><Icon name="arrow" size={14}/></a></aside></div></BaseLayout>
<style>
  .release-header { display: grid; grid-template-columns: 98px minmax(0, 1fr); align-items: center; gap: 28px; padding: 9px 0 28px; }
  .release-cover-link img { width: 98px; height: 137px; object-fit: cover; border: 1px solid var(--border-strong); padding: 3px; border-radius: 4px; }
  .release-heading-copy { min-width: 0; } h1 { font: 400 clamp(1.9rem, 3.5vw, 3rem)/1.17 var(--font-display); letter-spacing: -.04em; margin: 15px 0; text-wrap: balance; }
  .release-heading-copy > p { color: var(--muted); font-size: .91rem; margin-bottom: 17px; } .release-date { color: var(--subtle); font-size: .7rem; margin-left: 8px; }
  .release-jumps { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 27px; border-block: 1px solid var(--border); padding: 3px 0; }
  .release-jumps a { display: flex; align-items: center; gap: 7px; min-height: 44px; color: var(--muted); font-size: .77rem; } .release-jumps a:hover { color: var(--accent); }
  .release-layout { display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 42px; margin-top: 30px; } article { min-width: 0; } .release-sidebar { align-self: start; position: sticky; top: 105px; min-width: 0; }
  .release-section { scroll-margin-top: 108px; } .release-section + .release-section { margin-top: 32px; } .release-section > h2 { margin-bottom: 17px; } .tracks, .tech-blocks, .comparison-stack { display: grid; gap: 12px; }
  .track { display: flex; gap: 13px; align-items: center; padding: 13px 16px; font-size: .8rem; color: var(--muted); } .track-number { color: var(--accent); } .track .badge { margin-left: auto; }
  .specs, .downloads { padding: 22px; scroll-margin-top: 106px; } .release-sidebar section + section { margin-top: 17px; } .release-sidebar h2 { font-size: 1.06rem; }
  dl { margin: 16px 0 0; } dl div { display: flex; justify-content: space-between; gap: 15px; border-top: 1px solid var(--border); padding: 11px 0; font-size: .75rem; } dt { color: var(--subtle); } dd { margin: 0; text-align: right; overflow-wrap: anywhere; font-size: .7rem; }
  .downloads .button { width: 100%; margin-top: 13px; justify-content: flex-start; padding-inline: 13px; } .downloads .button > :global(svg:last-child) { margin-left: auto; } .downloads small { display: block; color: var(--subtle); font-size: .65rem; margin-top: 3px; }
  .downloads .button:first-of-type { color: var(--canvas); background: var(--accent); border-color: var(--accent); } .downloads .button:first-of-type small { color: inherit; opacity: .8; }
  .series-link { margin-top: 17px; display: flex; align-items: center; gap: 12px; padding: 14px; } .series-link img { width: 43px; height: 60px; border-radius: 3px; object-fit: cover; } .series-link div { min-width: 0; } .series-link span { font-size: .56rem; } .series-link strong { display: block; font-size: .83rem; margin-top: 5px; } .series-link > :global(svg) { margin-left: auto; color: var(--accent); flex-shrink: 0; }
  .changelog > div { padding: 16px 0; border-top: 1px solid var(--border); } .changelog time { margin-left: 12px; font-size: .65rem; } .changelog p { margin-top: 10px; color: var(--muted); font-size: .84rem; }
  @media (max-width: 1000px) { .release-layout { grid-template-columns: minmax(0, 1fr) 270px; gap: 26px; } .specs, .downloads { padding: 18px; } }
  @media (max-width: 760px) { .release-layout { display: flex; flex-direction: column-reverse; gap: 28px; } .release-sidebar { position: static; width: 100%; } .release-header { grid-template-columns: 70px minmax(0, 1fr); gap: 18px; } .release-cover-link img { width: 70px; height: 98px; } h1 { font-size: 1.85rem; } .release-date { margin-left: 0; } .release-jumps { gap: 4px 19px; } .track { flex-wrap: wrap; } }
  @media (max-width: 480px) { .release-header { display: block; } .release-cover-link { float: left; margin: 0 17px 14px 0; } .release-heading-copy > .pill-row { clear: both; padding-top: 6px; } }
</style>
