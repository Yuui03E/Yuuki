---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ReleasesTable from '../../components/ReleasesTable.astro';
import { isAdult } from '../../lib/audience.mjs';
import { getArchive } from '../../lib/archive';
export async function getStaticPaths() { const archive = await getArchive({ audience: 'all' }); return archive.anime.map((entry) => ({ params: { id: entry.id }, props: { entry, episodes: archive.episodes.filter((episode) => episode.data.anime.id === entry.id && (isAdult(entry.data) || !isAdult(episode.data))) } })); }
const { entry, episodes } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const metadata = [ ['Format', d.format], ['Season', [d.season, d.year].filter(Boolean).join(' ')], ['Source', d.sourceType], ['Studio', d.studios?.join(', ')], ['Default codec', d.defaultCodec], ['Japanese title', d.japaneseTitle], ['AniList ID', d.anilistId] ].filter(([, value]) => value !== undefined && value !== '');
---
<BaseLayout title={d.title} description={d.synopsis} image={d.coverImage} adult={isAdult(d)} searchable searchType={d.mediaType === 'MANGA' ? 'Manga' : 'Anime'}><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/anime/">Archive</a><span>/</span><span>{d.mediaType}</span></div>{d.bannerImage && <div class="series-banner"><img src={d.bannerImage} alt={`${d.title} banner`} width="960" height="560"/></div>}<section class="series-header"><img class="series-cover" src={d.coverImage} alt={`${d.title} cover`} width="600" height="840"/><div class="series-info"><div class="pill-row"><span class="badge badge-cyan">{d.mediaType}</span><span class="badge badge-green">{d.status}</span><span class="badge">{d.releaseTag}</span></div><h1 data-pagefind-meta="title">{d.title}</h1>{d.romajiTitle && d.romajiTitle !== d.title && <p class="romaji">{d.romajiTitle}</p>}<p class="synopsis">{d.synopsis}</p><div class="pill-row tags">{d.tags.map((tag) => <span class="badge">{tag}</span>)}</div>{d.totalEpisodes !== undefined && <div class="series-progress"><span class="mono">{d.completedEpisodes !== undefined ? `${d.completedEpisodes} / ${d.totalEpisodes}` : d.totalEpisodes} {d.mediaType === 'MANGA' ? 'chapters' : 'episodes'}{d.completedEpisodes !== undefined ? ' archived' : ' in the series'}</span>{d.completedEpisodes !== undefined && d.totalEpisodes > 0 && <progress max={d.totalEpisodes} value={d.completedEpisodes} aria-label="Archive completion"></progress>}</div>}{d.anilistId && <a href={`https://anilist.co/${d.mediaType.toLowerCase()}/${d.anilistId}/`} target="_blank" rel="noreferrer" class="text-link anilist-link">View on AniList ↗</a>}{episodes.length > 0 && <div class="series-actions"><a class="button button-primary" href="#series-releases">View releases <Icon name="arrow" size={16}/></a></div>}</div></section><div class="series-body"><aside class="metadata panel"><h2>Series details</h2><dl>{metadata.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></aside><div class="prose"><Content/></div></div><section class="series-releases" id="series-releases"><div class="section-heading"><h2>Linked releases <span class="count">{episodes.length}</span></h2></div>{episodes.length ? <ReleasesTable episodes={episodes} anime={[entry]}/> : <p class="empty-state">No published releases yet. Check the activity log for the next update.</p>}</section></BaseLayout>
<style>
  .series-banner { height: 230px; border: 1px solid var(--border); border-radius: 4px; overflow: hidden; margin-bottom: 30px; }
  .series-banner img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .series-header { display: grid; grid-template-columns: 175px minmax(0, 1fr); gap: 36px; padding-bottom: 30px; border-bottom: 1px solid var(--border); }
  .series-cover { width: 175px; height: 245px; object-fit: cover; padding: 4px; border-radius: 4px; border: 1px solid var(--border-strong); background: var(--surface); }
  .series-info { min-width: 0; } h1 { font: 400 clamp(2.2rem, 4vw, 3.5rem)/1.15 var(--font-display); letter-spacing: -.045em; margin: 17px 0 9px; text-wrap: balance; }
  .romaji { color: var(--subtle); font-size: .85rem; } .synopsis { max-width: 800px; color: var(--muted); margin-top: 18px; line-height: 1.85; font-size: .9rem; }
  .tags { margin-top: 18px; } .series-progress { display: flex; flex-direction: column; gap: 10px; margin-top: 22px; max-width: 340px; font-size: .67rem; color: var(--muted); }
  progress { width: 100%; height: 4px; accent-color: var(--accent); } .anilist-link { margin-top: 13px; font-size: .76rem; } .series-actions { margin-top: 17px; }
  .series-body { display: grid; grid-template-columns: 285px minmax(0, 1fr); gap: 36px; margin-top: 30px; align-items: start; } .series-body > .prose { max-width: 820px; font-size: .92rem; min-width: 0; }
  .metadata { padding: 22px; } .metadata h2 { font-size: 1.06rem; } dl { margin: 17px 0 0; } dl div { display: grid; grid-template-columns: 85px minmax(0, 1fr); gap: 12px; padding-block: 11px; border-top: 1px solid var(--border); font-size: .74rem; }
  dt { color: var(--subtle); } dd { margin: 0; overflow-wrap: anywhere; } .series-releases { margin-top: 38px; scroll-margin-top: 105px; }
  @media (max-width: 760px) { .series-header { grid-template-columns: 110px minmax(0, 1fr); gap: 21px; } .series-cover { width: 110px; height: 154px; } h1 { font-size: 2rem; } .synopsis { font-size: .85rem; } .series-body { grid-template-columns: 1fr; gap: 25px; } .series-banner { height: 160px; margin-bottom: 22px; } }
  @media (max-width: 480px) { .series-header { display: block; } .series-cover { float: left; margin: 0 18px 12px 0; } .series-info .synopsis { clear: both; padding-top: 14px; } }
</style>
