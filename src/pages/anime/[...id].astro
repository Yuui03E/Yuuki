---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleasesTable from '../../components/ReleasesTable.astro';
import { getArchive } from '../../lib/archive';
export async function getStaticPaths() { const archive = await getArchive(); return archive.anime.map((entry) => ({ params: { id: entry.id }, props: { entry, episodes: archive.episodes.filter((episode) => episode.data.anime.id === entry.id) } })); }
const { entry, episodes } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const metadata = [ ['Format', d.format], ['Season', [d.season, d.year].filter(Boolean).join(' ')], ['Source', d.sourceType], ['Studio', d.studios?.join(', ')], ['Default codec', d.defaultCodec], ['Japanese title', d.japaneseTitle], ['AniList ID', d.anilistId] ].filter(([, value]) => value !== undefined && value !== '');
---
<BaseLayout title={d.title} description={d.synopsis} image={d.coverImage} searchable searchType={d.mediaType === 'MANGA' ? 'Manga' : 'Anime'}><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/anime/">Archive</a><span>/</span><span>{d.mediaType}</span></div>{d.bannerImage && <div class="series-banner"><img src={d.bannerImage} alt={`${d.title} banner`} width="960" height="560"/></div>}<section class="series-header"><img class="series-cover" src={d.coverImage} alt={`${d.title} cover`} width="600" height="840"/><div class="series-info"><div class="pill-row"><span class="badge badge-cyan">{d.mediaType}</span><span class="badge badge-green">{d.status}</span><span class="badge">{d.releaseTag}</span></div><h1 data-pagefind-meta="title">{d.title}</h1>{d.romajiTitle && <p class="romaji">{d.romajiTitle}</p>}<p class="synopsis">{d.synopsis}</p><div class="pill-row tags">{d.tags.map((tag) => <span class="badge">{tag}</span>)}</div>{d.totalEpisodes !== undefined && <div class="series-progress"><span class="mono">{d.completedEpisodes ?? 0} / {d.totalEpisodes} {d.mediaType === 'MANGA' ? 'chapters' : 'episodes'} archived</span><progress max={d.totalEpisodes || 1} value={d.completedEpisodes ?? 0} aria-label="Archive completion"></progress></div>}{d.anilistId && <a href={`https://anilist.co/${d.mediaType.toLowerCase()}/${d.anilistId}/`} target="_blank" rel="noreferrer" class="text-link anilist-link">View on AniList ↗</a>}</div></section><div class="series-body"><aside class="metadata panel"><h2>Source notebook</h2><dl>{metadata.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></aside><div class="prose"><Content/></div></div><section class="series-releases"><div class="section-heading"><h2>Linked releases <span class="count">{episodes.length}</span></h2></div>{episodes.length ? <ReleasesTable episodes={episodes} anime={[entry]}/> : <p class="empty-state">No published releases yet. Check the activity log for the next update.</p>}</section></BaseLayout>
<style>
  .series-banner { height: 200px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 25px; }
  .series-banner img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .series-header { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 30px; }
  .series-cover { width: 190px; height: 266px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); }
  h1 { margin: 13px 0 7px; } .romaji { color: var(--subtle); font-size: .88rem; }
  .synopsis { max-width: 820px; color: var(--muted); margin-top: 16px; line-height: 1.8; }
  .tags { margin-top: 17px; } .series-progress { display: flex; flex-direction: column; gap: 8px; margin-top: 20px; max-width: 360px; font-size: .67rem; color: var(--muted); }
  progress { width: 100%; height: 4px; accent-color: var(--cyan); } .anilist-link { margin-top: 16px; font-size: .74rem; }
  .series-body { display: grid; grid-template-columns: 310px minmax(0, 800px); gap: 30px; margin-top: 30px; align-items: start; }
  .metadata { padding: 18px; } .metadata h2 { font-size: 1rem; } dl { margin: 16px 0 0; } dl div { display: grid; grid-template-columns: 95px minmax(0, 1fr); gap: 12px; padding-block: 9px; border-top: 1px solid var(--border); font-size: .74rem; }
  dt { color: var(--subtle); } dd { margin: 0; overflow-wrap: anywhere; } .series-releases { margin-top: 32px; }
  @media (max-width: 760px) { .series-header { grid-template-columns: 110px minmax(0, 1fr); gap: 17px; } .series-cover { width: 110px; height: 154px; } h1 { font-size: 1.7rem; } .synopsis { font-size: .85rem; } .series-body { grid-template-columns: 1fr; gap: 22px; } .series-banner { height: 140px; } }
  @media (max-width: 480px) { .series-header { display: block; } .series-cover { float: left; margin: 0 17px 12px 0; } .series-info .synopsis { clear: both; padding-top: 12px; } }
</style>
