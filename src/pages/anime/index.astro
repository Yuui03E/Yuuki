---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimeCard from '../../components/AnimeCard.astro';
import { getArchive } from '../../lib/archive';
const { anime } = await getArchive();
---
<BaseLayout title="Anime & manga archive"><div class="page-heading"><span class="eyebrow">The collection / Anime & manga</span><h1>In the archive<span class="cyan">.</span></h1><p>Every series, its sources, and the releases along the way.</p></div><section data-archive-catalog><div class="catalog-toolbar panel"><div class="pill-row" role="group" aria-label="Media type">{['All', 'Anime', 'Manga'].map((filter) => <button class="filter-pill" type="button" data-catalog-filter={filter.toLowerCase()} aria-pressed={filter === 'All'}>{filter}</button>)}</div><label><span class="sr-only">Search archive</span><input type="search" data-catalog-search placeholder="Title, genre, or tag…"/></label><span class="mono subtle" data-catalog-count>{anime.length} entries</span></div><div class="archive-grid">{anime.map((entry) => <AnimeCard entry={entry}/>)}</div><p class="empty-state" data-catalog-empty hidden>No entries match these filters.</p></section></BaseLayout>
<script>import { initCatalog } from '../../scripts/catalog'; initCatalog('[data-archive-catalog]', '[data-archive-card]', 'type');</script>
<style>
  .catalog-toolbar { display: flex; align-items: center; gap: 18px; padding: 12px 16px; margin-bottom: 20px; }
  label { width: 280px; margin-left: auto; } input { font-size: .8rem; padding-block: 7px; }
  [data-catalog-count] { font-size: .64rem; }
  .archive-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(225px, 1fr)); gap: 18px; }
  @media (max-width: 760px) { .catalog-toolbar { flex-wrap: wrap; gap: 10px; } label { width: 100%; order: 3; } [data-catalog-count] { margin-left: auto; } .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
  @media (max-width: 400px) { .archive-grid { grid-template-columns: 1fr; } }
</style>
