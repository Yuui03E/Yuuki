---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import GuideCard from '../../components/GuideCard.astro';
import Icon from '../../components/Icon.astro';
import { getArchive } from '../../lib/archive';
const { guides } = await getArchive();
const categories = ['All', ...new Set(guides.map((entry) => entry.data.category))];
---
<BaseLayout title="Technical guide library" description="Practical encoding, filtering, and playback guides from Yuuki’s workbench.">
  <PageIntro eyebrow="Field notes / guides & workflows" title="A shared notebook." description="Settings are more useful with a little context. Practical workflows, careful experiments, and the reasoning behind the choices." count={guides.length} countLabel="published guides"/>
  <section data-guide-catalog><div class="catalog-toolbar"><div class="pill-row" role="group" aria-label="Guide category">{categories.map((category) => <button type="button" class="filter-pill" data-catalog-filter={category.toLowerCase()} aria-pressed={category === 'All'}>{category}</button>)}</div><label class="catalog-search"><Icon name="search" size={16}/><span class="sr-only">Search guides</span><input type="search" placeholder="Search field notes…" data-catalog-search/></label><span class="catalog-count mono" data-catalog-count aria-live="polite">{guides.length} entries</span></div><div class="guide-grid">{guides.map((entry, index) => <GuideCard entry={entry} index={index}/>)}</div><p class="empty-state" data-catalog-empty hidden>No guides match these filters.</p></section>
</BaseLayout>
<script>import { initCatalog } from '../../scripts/catalog'; initCatalog('[data-guide-catalog]', '[data-guide-card]', 'category');</script>
<style>.guide-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; } @media (max-width: 760px) { .guide-grid { grid-template-columns: 1fr; } }</style>
