---
import BaseLayout from '../layouts/BaseLayout.astro';
import FrameCompare from '../components/FrameCompare.astro';
import MetricChart from '../components/MetricChart.astro';
import { getArchive, pathFor, releaseTitle } from '../lib/archive';
const { anime, episodes, benchmarks } = await getArchive();
const seriesMap = new Map(anime.map((entry) => [entry.id, entry]));
const pairs = episodes.flatMap((entry) => (entry.data.comparisons ?? []).map((comparison, index) => ({ entry, comparison, id: `${entry.id.replace(/\//g, '-')}-${index}` })));
---
<BaseLayout title="Frame comparisons & benchmarks" description="Inspect source and encode frames at native resolution, then explore rate–distortion measurements." searchable searchType="Comparison"><div class="page-heading"><span class="eyebrow">The inspection bench</span><h1>Look a little closer<span class="cyan">.</span></h1><p>Compare the frame, then read the curve. Perceptual metrics inform a decision; your eyes finish it.</p></div><div class="inspection-note panel"><span class="badge badge-cyan">INSPECTION TIPS</span><p>Drag the split, switch with <kbd>1</kbd> / <kbd>2</kbd>, or lock to native pixels. Focus a comparison to use its keyboard controls.</p></div><section class="comparison-section"><div class="section-heading"><h2>Frame pairs <span class="count">{pairs.length}</span></h2><span class="mono subtle section-note">LOCAL SVG DEMONSTRATIONS</span></div><div class="frame-grid">{pairs.map(({ entry, comparison, id }) => <div><a href={pathFor('releases', entry.id)} class="release-reference mono">{releaseTitle(entry, seriesMap.get(entry.data.anime.id))} ↗</a><FrameCompare comparison={comparison} id={id}/></div>)}</div>{pairs.length === 0 && <p class="empty-state">Frame comparisons will appear here when added to a release.</p>}</section><section class="comparison-section"><div class="section-heading"><h2>Rate–distortion notebook <span class="count">{benchmarks.length}</span></h2></div><div class="benchmark-stack">{benchmarks.map((benchmark) => <MetricChart benchmark={benchmark}/>)}</div></section></BaseLayout>
<style>.inspection-note { display: flex; align-items: center; gap: 14px; padding: 13px 17px; } .inspection-note p { color: var(--muted); font-size: .8rem; } .comparison-section { margin-top: 30px; } .section-note { font-size: .58rem; } .frame-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; } .release-reference { display: inline-block; color: var(--subtle); font-size: .64rem; margin-bottom: 9px; } .release-reference:hover { color: var(--cyan); } .benchmark-stack { display: grid; gap: 20px; } @media (max-width: 1000px) { .frame-grid { grid-template-columns: 1fr; } } @media (max-width: 760px) { .inspection-note { align-items: flex-start; flex-direction: column; gap: 9px; } .section-note { display: none; } }</style>
