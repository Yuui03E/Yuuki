---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { getArchive, formatDate, pathFor } from '../lib/archive';
const { anime, progress } = await getArchive();
const logs = await Promise.all(progress.map(async (entry) => ({ entry, ...await render(entry) })));
const stages = ['Inspect the source', 'Filter where it helps', 'Encode a test sample', 'Check the frames', 'Mux and document the release'];
---
<BaseLayout title="About Yuuki">
  <PageIntro eyebrow="Behind the archive" title="A personal archive. An open notebook." description="Yuuki brings together anime, manga, and the craft of encoding. A place to keep the work, explain the choices, and share what is learned along the way."/>
  <div class="about-grid"><section class="philosophy"><span class="eyebrow">The approach</span><h2>Care in every frame<span> /</span></h2><div class="principle"><span class="mono">01</span><div><h3>Respect the source.</h3><p>Clean lineart, quiet gradients, and texture worth keeping. File size is one part of the decision; the scene is the reference.</p></div></div><div class="principle"><span class="mono">02</span><div><h3>Keep the notes.</h3><p>Source information, settings, and release changes belong beside the file. Technical details appear when they are available.</p></div></div><div class="principle"><span class="mono">03</span><div><h3>Share the process.</h3><p>Guides and comparisons make the work easier to understand. A measurement can inform a choice; looking at the frame still matters.</p></div></div></section><section class="pipeline panel"><span class="eyebrow">From source to release</span><h2>A little method<br/><em>behind the magic.</em></h2><ol>{stages.map((stage, index) => <li><span class="mono">{String(index + 1).padStart(2, '0')}</span>{stage}</li>)}</ol><a href="/guides/" class="text-link">Read the practical guides <Icon name="arrow" size={15}/></a></section></div>
  <section class="progress-section" id="progress"><div class="section-heading"><h2><span class="section-number">04</span> Notes from the workbench <span class="count">{logs.length}</span></h2><span class="mono subtle log-order">NEWEST FIRST</span></div><div class="timeline">{logs.map(({ entry, Content }) => { const related = anime.find((series) => series.id === entry.data.relatedAnime?.id); return <article class="log-entry"><time class="mono" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time><div class="log-content"><div class="pill-row"><span class="badge badge-violet">{entry.data.category}</span><span class:list={['badge', { 'badge-green': entry.data.stage === 'Completed' }]}>{entry.data.stage}</span>{related && <a href={pathFor('anime', related.id)} class="text-link">{related.data.title} <Icon name="arrow" size={13}/></a>}</div><h3>{entry.data.title}</h3><div class="prose"><Content/></div></div></article>; })}</div>{!logs.length && <p class="empty-state">Updates will appear here as the work moves forward.</p>}</section>
</BaseLayout>
<style>
  .about-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 64px; margin-top: 10px; }
  .philosophy { padding-top: 17px; } .philosophy h2 { font: 400 2rem/1.3 var(--font-display); margin: 17px 0 25px; } .philosophy h2 span { font-style: italic; color: var(--accent); }
  .principle { display: flex; align-items: baseline; gap: 24px; border-top: 1px solid var(--border); padding: 22px 0; }
  .principle > span { color: var(--accent); font-size: .67rem; } .principle h3 { font-size: 1rem; margin-bottom: 10px; }
  .principle p { color: var(--muted); font-size: .86rem; line-height: 1.85; }
  .pipeline { padding: 30px; background: var(--accent-wash); align-self: start; }
  .pipeline h2 { font: 400 2.4rem/1.18 var(--font-display); margin: 22px 0 25px; } .pipeline em { color: var(--accent); }
  .pipeline ol { list-style: none; padding: 0; margin: 0 0 20px; } .pipeline li { display: flex; align-items: center; gap: 18px; border-top: 1px solid var(--border); padding: 13px 0; font-size: .85rem; } .pipeline li span { color: var(--subtle); font-size: .65rem; }
  .progress-section { margin-top: 42px; scroll-margin-top: 108px; } .log-order { font-size: .6rem; }
  .timeline { border-top: 1px solid var(--border); } .log-entry { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 30px; padding: 26px 0; border-bottom: 1px solid var(--border); }
  .log-entry > time { color: var(--subtle); font-size: .68rem; padding-top: 5px; } .log-content { border-left: 1px solid var(--border-strong); padding-left: 28px; min-width: 0; }
  .log-content h3 { font: 400 1.55rem/1.3 var(--font-display); margin: 16px 0 12px; } .log-content .prose { font-size: .85rem; max-width: 780px; }
  @media (max-width: 1000px) { .about-grid { gap: 30px; } }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; gap: 18px; } .pipeline { padding: 24px; } .pipeline h2 { font-size: 2rem; } .principle { gap: 18px; } .log-entry { grid-template-columns: 1fr; gap: 13px; } .log-content { padding-left: 18px; } .log-order { display: none; } }
</style>
