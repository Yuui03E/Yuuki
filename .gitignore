# Build output, local state, secrets, and original sources
node_modules/
dist/
.astro/
.env*
raw-sources/
media-library/
local-backups/
.wrangler/
publishing.local.json
.code-only-check-*/
.npm-cache/
test-results/
playwright-report/
*.log
.DS_Store
Thumbs.db

# Keep bulk images out of GitHub; only small root-level SVG samples are tracked.
public/images/*
!public/images/*.svg

# All real editorial data is local. Only empty collection placeholders are tracked.
src/content/**
!src/content/**/
!src/content/**/.gitkeep

# Raw video, audio, and archives must never be committed
*.mkv
*.mp4
*.m2ts
*.ts
*.webm
*.flac
*.wav
*.opus
*.aac
*.7z
*.zip
*.rar
*.iso

# Keep TypeScript source; .ts above also matches MPEG transport streams
!src/**/*.ts
!tests/**/*.ts
!scripts/**/*.ts
!*.config.ts
