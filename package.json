{
  "name": "yuuki-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "clean": "node scripts/clean.mjs",
    "media:check": "node scripts/media-library.mjs",
    "media:deploy": "node scripts/deploy-media.mjs",
    "media:organize": "node scripts/organize-media.mjs",
    "media:backup": "node scripts/organize-media.mjs --backup-only",
    "build": "node scripts/build-local.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "publish:site": "node scripts/publish-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:production": "node scripts/verify-production.mjs",
    "test:code-only": "node scripts/verify-code-only.mjs",
    "verify": "npm run check:repo && npm run check && npm run build && npm test && npm run test:e2e && npm run test:production && npm run test:code-only"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.5",
    "@mdx-js/mdx": "3.1.1",
    "astro": "7.4.11",
    "chart.js": "4.6.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "pagefind": "1.6.0",
    "typescript": "6.0.3",
    "wrangler": "4.161.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
