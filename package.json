{
  "name": "yuuki-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/studio.test.mjs",
    "test:e2e": "playwright test",
    "test:production": "node scripts/verify-production.mjs",
    "verify": "npm run check && npm run build && npm test && npm run test:e2e && npm run test:production"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.5",
    "@mdx-js/mdx": "3.1.1",
    "astro": "7.4.11",
    "chart.js": "4.6.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "pagefind": "1.6.0",
    "typescript": "6.0.3"
  }
}
